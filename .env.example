# Секреты задаются только в окружении, в git не попадают.
# Ключ шлюза Cloud.ru на ВМ лежит в /opt/hackathon/ai.env; scripts/deploy_vm.sh переносит ключ и адрес в .env как LLM_API_KEY и LLM_BASE_URL.
SECRET_KEY=
LLM_PROVIDERS=cloudru          # cloudru | fixtures (без сети, резервная генерация)
LLM_JUDGE_ENABLED=true
# LLM_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
# LLM_API_KEY=
# LLM_MODEL_GENERATE=GigaChat/GigaChat-3-Pro
# LLM_MODEL_JUDGE=ai-sage/GigaChat3.5-432B-A28B-Reasoning
# Токены (ТЗ, 4.11): доступ 30 минут, обновление 30 дней
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=30
# Лимиты: новых программ в час на пользователя и для роли api
# PROGRAMS_PER_HOUR=30
# API_PROGRAMS_PER_HOUR=30
