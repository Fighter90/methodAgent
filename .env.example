# Секреты задаются только в окружении, в git не попадают.
# Ключ шлюза Cloud.ru на ВМ лежит в /opt/hackathon/ai.env; scripts/deploy_vm.sh переносит ключ и адрес в .env как LLM_API_KEY и LLM_BASE_URL.
SECRET_KEY=
LLM_PROVIDERS=cloudru          # cloudru | fixtures (без сети, резервная генерация)
LLM_JUDGE_ENABLED=true
